rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1: Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Pillar 2: Validation Blueprint for AlertSubscription
    function isValidAlertSubscription(data) {
      return data.keys().hasAll([
        'ownerId',
        'districtId',
        'districtNameTh',
        'spiThreshold',
        'rainProbThreshold',
        'maxTempThresholdC',
        'enableExtremeWeather',
        'enableSpiAlert',
        'isActive',
        'cropFocus',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'ownerId',
        'districtId',
        'districtNameTh',
        'spiThreshold',
        'rainProbThreshold',
        'maxTempThresholdC',
        'enableExtremeWeather',
        'enableSpiAlert',
        'isActive',
        'cropFocus',
        'createdAt',
        'updatedAt'
      ]) &&
      data.ownerId is string &&
      data.ownerId.size() >= 1 &&
      data.ownerId.size() <= 128 &&
      data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.ownerId == request.auth.uid &&
      data.districtId is string &&
      data.districtId.size() >= 2 &&
      data.districtId.size() <= 64 &&
      data.districtId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.districtNameTh is string &&
      data.districtNameTh.size() >= 2 &&
      data.districtNameTh.size() <= 120 &&
      data.spiThreshold is number &&
      data.spiThreshold >= -4.0 &&
      data.spiThreshold <= 4.0 &&
      data.rainProbThreshold is number &&
      data.rainProbThreshold >= 0 &&
      data.rainProbThreshold <= 100 &&
      data.maxTempThresholdC is number &&
      data.maxTempThresholdC >= 20 &&
      data.maxTempThresholdC <= 50 &&
      data.enableExtremeWeather is bool &&
      data.enableSpiAlert is bool &&
      data.isActive is bool &&
      data.cropFocus is string &&
      data.cropFocus.size() >= 1 &&
      data.cropFocus.size() <= 120 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // Pillar 2: Validation Blueprint for AlertLog
    function isValidAlertLog(data) {
      return data.keys().hasAll([
        'ownerId',
        'districtId',
        'districtNameTh',
        'alertType',
        'severity',
        'title',
        'message',
        'metricSummary',
        'isRead',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'ownerId',
        'districtId',
        'districtNameTh',
        'alertType',
        'severity',
        'title',
        'message',
        'metricSummary',
        'isRead',
        'createdAt',
        'updatedAt'
      ]) &&
      data.ownerId is string &&
      data.ownerId.size() >= 1 &&
      data.ownerId.size() <= 128 &&
      data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.ownerId == request.auth.uid &&
      data.districtId is string &&
      data.districtId.size() >= 2 &&
      data.districtId.size() <= 64 &&
      data.districtId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.districtNameTh is string &&
      data.districtNameTh.size() >= 2 &&
      data.districtNameTh.size() <= 120 &&
      data.alertType is string &&
      data.alertType.size() >= 3 &&
      data.alertType.size() <= 40 &&
      (data.alertType == 'spi_drought' ||
       data.alertType == 'extreme_weather' ||
       data.alertType == 'heavy_rain' ||
       data.alertType == 'heat_stress') &&
      data.severity is string &&
      data.severity.size() >= 3 &&
      data.severity.size() <= 24 &&
      (data.severity == 'critical' ||
       data.severity == 'warning' ||
       data.severity == 'advisory') &&
      data.title is string &&
      data.title.size() >= 2 &&
      data.title.size() <= 200 &&
      data.message is string &&
      data.message.size() >= 2 &&
      data.message.size() <= 600 &&
      data.metricSummary is string &&
      data.metricSummary.size() >= 2 &&
      data.metricSummary.size() <= 140 &&
      data.isRead is bool &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // Collection 1: Farmer District Alert Subscriptions
    match /alertSubscriptions/{subscriptionId} {
      allow get: if isVerifiedUser() &&
        isValidId(subscriptionId) &&
        existing().ownerId == request.auth.uid;

      allow list: if isVerifiedUser() &&
        resource.data.ownerId == request.auth.uid;

      allow create: if isVerifiedUser() &&
        isValidId(subscriptionId) &&
        isValidAlertSubscription(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerifiedUser() &&
        isValidId(subscriptionId) &&
        isValidAlertSubscription(incoming()) &&
        existing().ownerId == request.auth.uid &&
        incoming().ownerId == existing().ownerId &&
        incoming().districtId == existing().districtId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          // Action 1: Toggle Active Status
          incoming().diff(existing()).affectedKeys().hasOnly(['isActive', 'updatedAt']) ||
          // Action 2: Update Threshold Configuration
          incoming().diff(existing()).affectedKeys().hasOnly([
            'spiThreshold',
            'rainProbThreshold',
            'maxTempThresholdC',
            'enableExtremeWeather',
            'enableSpiAlert',
            'cropFocus',
            'isActive',
            'updatedAt'
          ])
        );

      allow delete: if isVerifiedUser() &&
        isValidId(subscriptionId) &&
        existing().ownerId == request.auth.uid;
    }

    // Collection 2: Dispatched Push Alert Logs
    match /alertLogs/{logId} {
      allow get: if isVerifiedUser() &&
        isValidId(logId) &&
        existing().ownerId == request.auth.uid;

      allow list: if isVerifiedUser() &&
        resource.data.ownerId == request.auth.uid;

      allow create: if isVerifiedUser() &&
        isValidId(logId) &&
        isValidAlertLog(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerifiedUser() &&
        isValidId(logId) &&
        isValidAlertLog(incoming()) &&
        existing().ownerId == request.auth.uid &&
        incoming().ownerId == existing().ownerId &&
        incoming().districtId == existing().districtId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          // Action 1: Mark Notification as Read/Unread
          incoming().diff(existing()).affectedKeys().hasOnly(['isRead', 'updatedAt'])
        );

      allow delete: if isVerifiedUser() &&
        isValidId(logId) &&
        existing().ownerId == request.auth.uid;
    }

    // Pillar 2: Validation Blueprint for ForumPost
    function isValidForumPost(data) {
      return data.keys().hasAll([
        'authorId',
        'authorName',
        'authorRole',
        'districtId',
        'districtNameTh',
        'category',
        'categoryNameTh',
        'postType',
        'cropTag',
        'title',
        'content',
        'likesCount',
        'replyCount',
        'isPinned',
        'isLocked',
        'isResolved',
        'moderationStatus',
        'reportCount',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'authorId',
        'authorName',
        'authorRole',
        'districtId',
        'districtNameTh',
        'category',
        'categoryNameTh',
        'postType',
        'cropTag',
        'title',
        'content',
        'likesCount',
        'replyCount',
        'isPinned',
        'isLocked',
        'isResolved',
        'moderationStatus',
        'reportCount',
        'moderatorNote',
        'createdAt',
        'updatedAt'
      ]) &&
      data.authorId is string &&
      data.authorId.size() >= 1 &&
      data.authorId.size() <= 128 &&
      data.authorId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.authorName is string &&
      data.authorName.size() >= 2 &&
      data.authorName.size() <= 100 &&
      data.authorRole is string &&
      (data.authorRole == 'farmer' ||
       data.authorRole == 'smart_farmer' ||
       data.authorRole == 'coop_leader' ||
       data.authorRole == 'agri_officer' ||
       data.authorRole == 'moderator') &&
      data.districtId is string &&
      data.districtId.size() >= 2 &&
      data.districtId.size() <= 64 &&
      data.districtId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.districtNameTh is string &&
      data.districtNameTh.size() >= 2 &&
      data.districtNameTh.size() <= 120 &&
      data.category is string &&
      (data.category == 'rice' ||
       data.category == 'cassava' ||
       data.category == 'sugarcane' ||
       data.category == 'corn' ||
       data.category == 'fruit' ||
       data.category == 'water_irrigation' ||
       data.category == 'fertilizer_soil' ||
       data.category == 'partnership_credit' ||
       data.category == 'machinery' ||
       data.category == 'general') &&
      data.categoryNameTh is string &&
      data.categoryNameTh.size() >= 2 &&
      data.categoryNameTh.size() <= 120 &&
      data.postType is string &&
      (data.postType == 'question' ||
       data.postType == 'advice' ||
       data.postType == 'discussion' ||
       data.postType == 'official_notice') &&
      data.cropTag is string &&
      data.cropTag.size() >= 1 &&
      data.cropTag.size() <= 80 &&
      data.title is string &&
      data.title.size() >= 3 &&
      data.title.size() <= 200 &&
      data.content is string &&
      data.content.size() >= 5 &&
      data.content.size() <= 3000 &&
      data.likesCount is number &&
      data.likesCount >= 0 &&
      data.replyCount is number &&
      data.replyCount >= 0 &&
      data.isPinned is bool &&
      data.isLocked is bool &&
      data.isResolved is bool &&
      data.moderationStatus is string &&
      (data.moderationStatus == 'active' ||
       data.moderationStatus == 'flagged' ||
       data.moderationStatus == 'hidden') &&
      data.reportCount is number &&
      data.reportCount >= 0 &&
      (!('moderatorNote' in data) || (data.moderatorNote is string && data.moderatorNote.size() <= 500)) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // Pillar 2: Validation Blueprint for ForumReply
    function isValidForumReply(data) {
      return data.keys().hasAll([
        'postId',
        'authorId',
        'authorName',
        'authorRole',
        'districtNameTh',
        'content',
        'likesCount',
        'isExpertAnswer',
        'isFlagged',
        'isHidden',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'postId',
        'authorId',
        'authorName',
        'authorRole',
        'districtNameTh',
        'content',
        'likesCount',
        'isExpertAnswer',
        'isFlagged',
        'isHidden',
        'createdAt',
        'updatedAt'
      ]) &&
      data.postId is string &&
      data.postId.size() >= 1 &&
      data.postId.size() <= 128 &&
      data.postId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.authorId is string &&
      data.authorId.size() >= 1 &&
      data.authorId.size() <= 128 &&
      data.authorId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.authorName is string &&
      data.authorName.size() >= 2 &&
      data.authorName.size() <= 100 &&
      data.authorRole is string &&
      (data.authorRole == 'farmer' ||
       data.authorRole == 'smart_farmer' ||
       data.authorRole == 'coop_leader' ||
       data.authorRole == 'agri_officer' ||
       data.authorRole == 'moderator') &&
      data.districtNameTh is string &&
      data.districtNameTh.size() >= 2 &&
      data.districtNameTh.size() <= 120 &&
      data.content is string &&
      data.content.size() >= 2 &&
      data.content.size() <= 2000 &&
      data.likesCount is number &&
      data.likesCount >= 0 &&
      data.isExpertAnswer is bool &&
      data.isFlagged is bool &&
      data.isHidden is bool &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // Collection 3: Community Forum Posts
    match /forumPosts/{postId} {
      // Anyone can read active community posts
      allow get: if isValidId(postId) && (resource.data.moderationStatus != 'hidden' || isSignedIn());
      allow list: if resource.data.moderationStatus != 'hidden' || isSignedIn();

      allow create: if isSignedIn() &&
        isValidId(postId) &&
        isValidForumPost(incoming()) &&
        incoming().authorId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        incoming().likesCount == 0 &&
        incoming().replyCount == 0 &&
        incoming().reportCount == 0 &&
        incoming().moderationStatus == 'active';

      allow update: if isSignedIn() &&
        isValidId(postId) &&
        isValidForumPost(incoming()) &&
        incoming().authorId == existing().authorId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          // Action 1: Author edits post content or resolves question
          (existing().authorId == request.auth.uid &&
           incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'cropTag', 'isResolved', 'updatedAt'])) ||
          // Action 2: Community Upvotes (likesCount change)
          incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'updatedAt']) ||
          // Action 3: Increments replyCount on new comment
          incoming().diff(existing()).affectedKeys().hasOnly(['replyCount', 'updatedAt']) ||
          // Action 4: Reporting content
          incoming().diff(existing()).affectedKeys().hasOnly(['reportCount', 'moderationStatus', 'updatedAt']) ||
          // Action 5: Moderator Pin / Lock / Moderation Status / Moderator Note
          incoming().diff(existing()).affectedKeys().hasOnly([
            'isPinned',
            'isLocked',
            'moderationStatus',
            'reportCount',
            'moderatorNote',
            'updatedAt'
          ])
        );

      allow delete: if isSignedIn() &&
        isValidId(postId) &&
        (existing().authorId == request.auth.uid);

      // Subcollection: Forum Replies under Post
      match /replies/{replyId} {
        allow get, list: if isValidId(postId) && isValidId(replyId);

        allow create: if isSignedIn() &&
          isValidId(postId) &&
          isValidId(replyId) &&
          isValidForumReply(incoming()) &&
          incoming().postId == postId &&
          incoming().authorId == request.auth.uid &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          incoming().likesCount == 0 &&
          incoming().isFlagged == false &&
          incoming().isHidden == false;

        allow update: if isSignedIn() &&
          isValidId(postId) &&
          isValidId(replyId) &&
          isValidForumReply(incoming()) &&
          incoming().postId == existing().postId &&
          incoming().authorId == existing().authorId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          (
            // Action 1: Author edits comment
            (existing().authorId == request.auth.uid &&
             incoming().diff(existing()).affectedKeys().hasOnly(['content', 'updatedAt'])) ||
            // Action 2: Community upvotes reply
            incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'updatedAt']) ||
            // Action 3: Mark as expert answer / Moderator flag or hide
            incoming().diff(existing()).affectedKeys().hasOnly([
              'isExpertAnswer',
              'isFlagged',
              'isHidden',
              'updatedAt'
            ])
          );

        allow delete: if isSignedIn() &&
          isValidId(postId) &&
          isValidId(replyId) &&
          (existing().authorId == request.auth.uid);
      }
    }
  }
}
